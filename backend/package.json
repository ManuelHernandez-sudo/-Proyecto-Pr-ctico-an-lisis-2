{
  "name": "incident-hub-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src",
    "test": "jest --ci --coverage",
    "audit:high": "npm audit --audit-level=high"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "rootDir": ".",
    "roots": ["<rootDir>/../tests/backend"],
    "modulePaths": ["<rootDir>/node_modules"],
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"],
    "testEnvironment": "node"
  }
}
